# =====================================================================
# FinSecure API — Exemplo de Variáveis de Ambiente (.env)
# Copie este arquivo para ".env" e preencha os valores antes de rodar:
#   Linux/macOS: cp .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# =====================================================================

# Chave secreta HMAC-SHA256 de 256 bits em hexadecimal (64 caracteres hex)
# Gere uma nova com: openssl rand -hex 32
JWT_SECRET=substitua_por_uma_chave_hex_de_64_caracteres_segura

# PostgreSQL 17
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finsecure_db
SPRING_DATASOURCE_USERNAME=finsecure_user
SPRING_DATASOURCE_PASSWORD=finsecure_password

# RabbitMQ 3
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_USERNAME=finsecure_user
SPRING_RABBITMQ_PASSWORD=finsecure_password

# Redis 7
SPRING_DATA_REDIS_HOST=localhost
